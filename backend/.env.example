ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of dashboard origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Optional: allow all Vercel preview deployments of your project
# CORS_ORIGIN_REGEX=https://churnsense-.*\.vercel\.app
# Optional: require X-API-Key on /predict endpoints
# API_KEY=change-me
MAX_BATCH_ROWS=10000
MAX_UPLOAD_MB=5
